# 通义听悟 / 阿里云凭据模板
# 用法：复制为 .env 并填入真实值，然后 `source .env`（.env 已被 .gitignore 忽略）。
# 千万不要把真实密钥提交到仓库。
#
# 需要配置的三个变量：
#   ALIBABA_CLOUD_ACCESS_KEY_ID
#   ALIBABA_CLOUD_ACCESS_KEY_SECRET
#   TINGWU_APP_KEY
# 下面用 export 形式，可直接 `source .env`。若你的加载方式需要裸键名，
# 去掉 export 与引号即可（如 ALIBABA_CLOUD_ACCESS_KEY_ID=你的值）。

# 阿里云 AccessKey（RAM 用户，建议仅授予听悟相关权限）
export ALIBABA_CLOUD_ACCESS_KEY_ID="你的AccessKeyId"
export ALIBABA_CLOUD_ACCESS_KEY_SECRET="你的AccessKeySecret"

# 通义听悟管控台创建的项目 AppKey
export TINGWU_APP_KEY="你的项目AppKey"

# 可选：通义听悟服务区域（默认 cn-beijing）
# export TINGWU_REGION="cn-beijing"
